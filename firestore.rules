rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function mail() { return request.auth.token.email.lower(); }

    // Daftar owner & crew tambahan diatur dari aplikasi (Pengaturan > Akses Tim)
    // dan disimpan di dokumen shops/habite/config/roles
    function hasRoles() { return exists(/databases/$(database)/documents/shops/habite/config/roles); }
    function roles() { return get(/databases/$(database)/documents/shops/habite/config/roles).data; }

    // OWNER utama (selalu bisa masuk, tidak bergantung dokumen roles)
    function isOwner() {
      return signedIn() && (
        mail() in ['gandhiawan13@gmail.com', 'gandhiawwan@gmail.com']
        || (hasRoles() && mail() in roles().owners)
      );
    }
    function isCrew() { return signedIn() && hasRoles() && mail() in roles().crew; }

    match /shops/habite/{col}/{id} {
      allow read: if isOwner() || isCrew();
      allow write: if isOwner();
      // crew hanya boleh MENAMBAH penjualan, pengeluaran, stok masuk, dan opname
      allow create: if isCrew() && col in ['sales', 'expenses', 'stockIns', 'opnames'];
      // crew hanya boleh MENGHAPUS penjualan
      allow delete: if isCrew() && col == 'sales';
    }
  }
}
